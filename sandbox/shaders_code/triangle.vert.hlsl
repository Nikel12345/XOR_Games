// Вершинник зонда очередей: треугольник без камеры и без трансформа.
//
// Позиция приходит СТРИМОМ ПУЛА (_VertexPosBuffer, FMT_PosStream: float3, страйд 12) и уже
// лежит в clip-пространстве — ни view, ни proj тут нет намеренно. Смысл зонда в маршруте
// данных между очередями, а не в геометрии: чем меньше между заливкой и пикселем, тем
// однозначнее вывод, если что-то не доедет.
//
// Цвет выводится из позиции, а не задан константой: константный цвет нарисовался бы и при
// пустом (занулённом) вершинном буфере, а зависимый — только если залитые байты реально
// доехали до графической очереди.

// Поправка на форму окна. NDC отображается на ВСЁ окно независимо от его пропорций: на
// 640x480 единица длины по горизонтали стоит 320 пикселей, а по вертикали 240. Без поправки
// вращение по окружности в NDC рисуется эллипсом на экране, и фигура «дышит» — заметнее всего
// на переходе между горизонтальной и вертикальной ориентацией.
//
// Поправка живёт ЗДЕСЬ, а не в буфере: вершины должны оставаться в квадратном пространстве,
// иначе вычислительный поворот перестал бы сохранять форму (он бы крутил уже искажённое).
cbuffer ViewParams : register(b0, space1) {
    float aspect;        // width / height окна
    // Добивать до 16 байт руками НЕ НАДО: cbuffer и так занимает целый регистр, а float3 после
    // float встал бы на офсет 4 и нарушил правило выравнивания uniform-блока (валидация:
    // «member 1 at offset 4 is not aligned to 16»). С++-сторона шлёт 16 байт, этого хватает.
};

struct VSInput
{
    float3 a_pos : POSITION;
};

struct VSOutput
{
    float4 position                     : SV_Position;
    [[vk::location(0)]] float3 v_color  : TEXCOORD0;
};

VSOutput main(VSInput input)
{
    VSOutput o;
    o.position = float4(input.a_pos.x / aspect, input.a_pos.y, input.a_pos.z, 1.0);
    // Цвет берётся из ИСХОДНОЙ позиции, до поправки: он про геометрию в буфере, а не про окно.
    // [-1,1] → [0,1], интерполяция даёт градиент.
    o.v_color  = input.a_pos * 0.5 + 0.5;
    return o;
}
