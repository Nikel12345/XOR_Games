// Compute-фаза зонда очередей: доворачивает вершины треугольника ВОКРУГ Z, прямо в
// вершинном буфере.
//
// Смысл — не геометрия, а маршрут. Буфер заливает КОПИРОВАЛЬНАЯ семья, крутит
// ВЫЧИСЛИТЕЛЬНАЯ, читает ГРАФИЧЕСКАЯ, и CPU после первой заливки его больше не трогает.
// Значит вращение на экране = доказательство, что все три семьи работают с одной памятью и
// видят чужие записи.
//
// Поворот ИНКРЕМЕНТАЛЬНЫЙ (на дельту за кадр), а не от исходного угла: так состояние живёт
// в самом буфере между кадрами. Абсолютный угол читался бы из пуша и не требовал бы, чтобы
// предыдущая запись вообще доехала.
//
// RWStructuredBuffer<float>, а не <float3>: у float3 в структурном буфере страйд зависит от
// правил раскладки (12 против 16), и промах здесь дал бы молча поехавшую геометрию.
// Скаляр — 4 байта всегда, вершина = три подряд.

RWStructuredBuffer<float> Verts : register(u0, space1);

cbuffer RotateParams : register(b0, space2) {
    float delta_angle;    // радиан за кадр
    uint  vertex_count;
};

[numthreads(64, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= vertex_count) return;

    uint base = i * 3u;
    float x = Verts[base + 0u];
    float y = Verts[base + 1u];

    float s, c;
    sincos(delta_angle, s, c);

    Verts[base + 0u] = x * c - y * s;
    Verts[base + 1u] = x * s + y * c;
    // z не трогаем: треугольник плоский, а лишняя запись только запутала бы вердикт
}
